---
import { HTML_LANG, LOCALES, localePath, type Locale } from '../i18n/locales';

interface Props { locale: Locale; path: string; title: string; description: string; noindex?: boolean }
const { locale, path, title, description, noindex = false } = Astro.props;
const abs = (l: Locale) => new URL(localePath(l, path), Astro.site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={abs(locale)} />
{LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(l)} />)}
<link rel="alternate" hreflang="x-default" href={abs('en')} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={abs(locale)} />
<meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
