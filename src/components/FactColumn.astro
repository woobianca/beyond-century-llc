---
interface Props { facts: { value: string; label: string }[] }
const { facts } = Astro.props;
---
<dl class="facts">
  {facts.map((f) => (
    <div class="fact">
      <dt>{f.value}</dt>
      <dd>{f.label}</dd>
    </div>
  ))}
</dl>

<style>
  .facts { margin: 0; border-top: 2px solid var(--ink); align-self: end; }
  .fact { padding: 22px 0; border-bottom: 1px solid var(--rule); }
  dt { font-family: var(--serif); font-size: 28px; font-weight: 500; line-height: 1.3; }
  dd { margin: 4px 0 0; font-size: 13.5px; color: var(--mute); line-height: 1.6; }
</style>
