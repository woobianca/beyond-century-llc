---
import { Image } from 'astro:assets';
import susan from '../assets/people/susan.png';
import { getCopy } from '../i18n/copy';
import type { Locale } from '../i18n/locales';

interface Props { locale: Locale }
const h = getCopy(Astro.props.locale).home;
---
<section class="band">
  <figure class="wrap quote">
    <Image src={susan} alt={h.quoteName} width={520} class="portrait" />
    <div>
      <blockquote>{h.quote}</blockquote>
      <figcaption><strong>{h.quoteName}</strong> · {h.quoteTitle}</figcaption>
    </div>
  </figure>
</section>

<style>
  .quote { display: grid; grid-template-columns: 240px 1fr; gap: 72px; align-items: center; margin: 0 auto; padding-top: 80px; padding-bottom: 80px; }
  .quote :global(.portrait) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; background: var(--rule); }
  blockquote { margin: 0; font-family: var(--serif); font-size: 27px; line-height: 1.55; }
  :lang(en) blockquote { font-size: 30px; line-height: 1.35; }
  figcaption { margin-top: 26px; font-size: 14px; color: var(--mute); }
  strong { color: var(--ink); font-weight: 600; }
  @media (max-width: 860px) {
    .quote { grid-template-columns: 1fr; gap: 32px; padding-top: 56px; padding-bottom: 56px; }
    .quote :global(.portrait) { max-width: 180px; }
    blockquote, :lang(en) blockquote { font-size: 22px; }
  }
</style>
