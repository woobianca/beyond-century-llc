---
interface Props { data: object | object[] }
const items = ([] as object[]).concat(Astro.props.data);
// Escape "<" so Sheet text can never close the script element.
const encode = (o: object) => JSON.stringify(o).replace(/</g, '\\u003c');
---
{items.map((item) => <script type="application/ld+json" set:html={encode(item)} />)}
