---
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.astro';
import Offices from '../../components/Offices.astro';
import { loadSiteData } from '../../data/site-data';
import { getCopy } from '../../i18n/copy';
import { staticLocalePaths, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return staticLocalePaths();
}
const locale = Astro.params.locale as Locale;
const c = getCopy(locale);
const { contact } = await loadSiteData();
---
<Base locale={locale} page="contact" path="contact">
  <header class="wrap page-head">
    <h1 class="display">{c.contact.heading}</h1>
    <p class="lede">{c.contact.intro}</p>
  </header>
  <section class="wrap section ruled layout">
    <ContactForm locale={locale} />
    <Offices contact={contact} locale={locale} />
  </section>
</Base>

<style>
  .page-head { padding-top: 88px; padding-bottom: 56px; }
  .page-head .lede { margin-top: 24px; }
  .layout { display: grid; grid-template-columns: 7fr 4fr; gap: 72px; align-items: start; }
  @media (max-width: 860px) {
    .page-head { padding-top: 56px; padding-bottom: 32px; }
    .layout { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
