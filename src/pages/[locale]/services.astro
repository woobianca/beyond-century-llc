---
import Base from '../../layouts/Base.astro';
import { getCopy } from '../../i18n/copy';
import { localePath, staticLocalePaths, type Locale } from '../../i18n/locales';

export function getStaticPaths() {
  return staticLocalePaths();
}
const locale = Astro.params.locale as Locale;
const c = getCopy(locale);
---
<Base locale={locale} page="services" path="services">
  <header class="wrap page-head">
    <p class="eyebrow">{c.home.eyebrow}</p>
    <h1 class="display">{c.services.heading}</h1>
    <p class="lede">{c.services.intro}</p>
  </header>
  {c.services.items.map((s, i) => (
    <section id={s.id} class="wrap section ruled split">
      <div>
        <p class="num">{String(i + 1).padStart(2, '0')}</p>
        <h2 class="h2">{s.title}</h2>
      </div>
      <div class="prose">
        <p class="summary">{s.summary}</p>
        {s.body.map((p) => <p>{p}</p>)}
      </div>
    </section>
  ))}
  <section class="wrap section ruled">
    <a class="btn" href={localePath(locale, 'contact')}>{c.home.ctaPrimary}</a>
  </section>
</Base>

<style>
  .page-head { padding-top: 88px; padding-bottom: 72px; }
  .page-head .lede { margin-top: 24px; }
  .num { font-family: var(--serif-en); font-style: italic; color: var(--accent); font-size: 18px; margin-bottom: 10px; }
  section[id] { scroll-margin-top: 24px; }
  .prose .summary { font-family: var(--sans); font-size: 15px; color: var(--accent); margin-bottom: 18px; }
  @media (max-width: 860px) { .page-head { padding-top: 56px; padding-bottom: 48px; } }
</style>
