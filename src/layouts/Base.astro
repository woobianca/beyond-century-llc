---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/noto-sans-sc/400.css';
import '@fontsource/noto-sans-sc/500.css';
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/400-italic.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCopy, type PageKey } from '../i18n/copy';
import { HTML_LANG, type Locale } from '../i18n/locales';

interface Props { locale: Locale; page: PageKey; path: string; noindex?: boolean }
const { locale, page, path, noindex } = Astro.props;
const meta = getCopy(locale).meta[page];
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo locale={locale} path={path} title={meta.title} description={meta.description} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <Header locale={locale} path={path} />
    <main id="main"><slot /></main>
    <Footer locale={locale} path={path} />
  </body>
</html>
